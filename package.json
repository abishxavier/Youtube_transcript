{
  "name": "youtube-multilingual-transcriber",
  "version": "1.0.0",
  "description": "Multilingual YouTube Video Transcriber, Synchronized Subtitle Player & Exporter",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=350 server.js",
    "dev": "node --watch server.js",
    "build:android": "npx cap copy && npx cap sync",
    "open:android": "npx cap open android"
  },
  "keywords": [
    "youtube",
    "transcription",
    "multilingual",
    "subtitles",
    "srt",
    "vtt",
    "video-player",
    "translation"
  ],
  "author": "Antigravity Dev",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@distube/ytdl-core": "^4.16.12",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "openai": "^7.19.0",
    "undici": "^8.10.1",
    "youtube-dl-exec": "^3.1.15",
    "youtube-transcript": "^1.2.1",
    "youtubei.js": "^18.0.0"
  }
}
